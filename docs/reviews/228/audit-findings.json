  "pronouns": [
    {
      "key": "content.cards.unreadablePage.text",
      "tokens": [
        "它"
      ],
      "zh": "無法打出，亦無法移除。攜它走到破曉，字句或會自行顯現。"
    },
    {
      "key": "content.events.cursedIdol.text",
      "tokens": [
        "它"
      ],
      "zh": "一尊玉像坐在顱骨砌成的座台上，散發微暖。它被留在此處，顯然另有緣由。"
    },
    {
      "key": "content.events.mirror.choices.1.label",
      "tokens": [
        "它"
      ],
      "zh": "將它打碎"
    },
    {
      "key": "content.events.voidChest.text",
      "tokens": [
        "它"
      ],
      "zh": "黑鐵箱獨坐幽暗，低鳴透入齒間。它的鎖早已破開。"
    },
    {
      "key": "content.quests.eighthOmen.resolved",
      "tokens": [
        "它"
      ],
      "zh": "第八凶兆從來不是凶兆。它是一扇門投下的影。"
    },
    {
      "key": "content.quests.hollowLamplighter.meetings.0.ask",
      "tokens": [
        "它"
      ],
      "zh": "你的提燈太吵。把它接下來收集的三點餘燼交給我。"
    },
    {
      "key": "content.quests.paleOnes.huntInscription",
      "tokens": [
        "它們"
      ],
      "zh": "擊敗三名蒼白之敵，追隨它們留下的寒冷光塵。"
    },
    {
      "key": "content.quests.unreadablePage.pages.4",
      "tokens": [
        "它"
      ],
      "zh": "第五頁——玫瑰窗是一幅地圖，不是紀念碑。將它點亮，再望向王冠之上。"
    },
    {
      "key": "content.quests.usurper.itemText",
      "tokens": [
        "它"
      ],
      "zh": "冰冷琉璃。沒有燈芯。商人不肯說是誰留下它。"
    },
    {
      "key": "content.whispers.0",
      "tokens": [
        "它"
      ],
      "zh": "有一種顏色，尖塔拒絕為它命名。"
    },
    {
      "key": "content.whispers.15",
      "tokens": [
        "它"
      ],
      "zh": "守夜有一扇窗，雖無牆承載它。"
    },
    {
      "key": "content.whispers.17",
      "tokens": [
        "他們"
      ],
      "zh": "蒼白眾並非在獵你。他們在向上指。"
    },
    {
      "key": "content.whispers.21",
      "tokens": [
        "它"
      ],
      "zh": "它的銘文等候得比守夜更久。"
    },
    {
      "key": "story.act4-node1.b1.l1",
      "tokens": [
        "它"
      ],
      "zh": "我們一直站在這一面。你望過它許多次,卻從未站過。"
    },
    {
      "key": "story.act4-node1.b1.l2",
      "tokens": [
        "它"
      ],
      "zh": "路你認得。你只是一直由另一面認得它。"
    },
    {
      "key": "story.act4-node4.b1.l2",
      "tokens": [
        "他們",
        "他們"
      ],
      "zh": "灰是他們燒剩的。樹靠灰長大,你行的路由他們的力氣鋪成。"
    },
    {
      "key": "story.act4-node4.b1.l5",
      "tokens": [
        "他們"
      ],
      "zh": "這一段最長,也最靜。你可以在這裏坐一會——他們等得起。"
    },
    {
      "key": "story.dawn.eighthOmen.done",
      "tokens": [
        "它",
        "它"
      ],
      "zh": "破曉來了,凶兆仍在。它不是凶兆:它是一扇門的影。影落得到這裏,就是說門一直都在,而且一直關着。"
    },
    {
      "key": "story.dawn.eighthOmen.p1",
      "tokens": [
        "它"
      ],
      "zh": "第八凶兆升起。冊上只有七個,第八個不在冊上。它落在路面,形狀太正,正得不像凶兆,倒像一件關着的東西投下的影。"
    },
    {
      "key": "story.dawn.ownShade.p1",
      "tokens": [
        "它",
        "它"
      ],
      "zh": "第一道影熄了。它認得你,喚過你的名字;你沒有停。它熄滅之處,地上沒有留下任何東西——影從來只是記憶。"
    },
    {
      "key": "story.dawn.paleOnes.done",
      "tokens": [
        "它"
      ],
      "zh": "九粒收足,透鏡不再生寒。彩窗有一格回應了你。窗上那點光不是新的:它是有人一直帶着,而沒有帶到門前的光。"
    },
    {
      "key": "story.dawn.paleOnes.p1",
      "tokens": [
        "他們"
      ],
      "zh": "第一粒光塵落進透鏡,冷得像霜。蒼白眾不追你,他們只朝東站着。守夜記下這一粒:在你之前,已有人把這段路走到這裏。"
    },
    {
      "key": "story.dawn.pane.2",
      "tokens": [
        "它們"
      ],
      "zh": "兩格亮了。窗開始有形狀:亮的位置不是隨意的,像早已為它們留好。"
    },
    {
      "key": "story.dawn.pane.4",
      "tokens": [
        "它"
      ],
      "zh": "四格亮,火比從前暖。你越看那扇窗,它越不像是用來望出去的。"
    },
    {
      "key": "story.dawn.pane.5",
      "tokens": [
        "它們"
      ],
      "zh": "五格亮,尚餘一格。窗裏的光不再各留各格,它們接連起來,像一件本來就是一整塊的東西。最後一片,還在路上。"
    },
    {
      "key": "story.dawn.unreadablePage.done",
      "tokens": [
        "它",
        "它"
      ],
      "zh": "五頁讀全。第五頁說彩窗是一幅地圖,不是紀念碑;地圖畫的是甚麼,頁上沒有寫。你越點亮它,它越不像一扇窗。"
    },
    {
      "key": "story.dawn.usurper.p1",
      "tokens": [
        "它"
      ],
      "zh": "無焰提燈到手。玻璃是冷的,燈芯不曾燒過。商人不肯說是誰留下它,只說這一種東西,總會自己回到西面來。"
    },
    {
      "key": "story.event-forgottenShrine.c0",
      "tokens": [
        "它"
      ],
      "zh": "你把一件不願再帶的東西放在龕前。石中那樣東西看着你,沒有回應——它等的不是祈禱。"
    },
    {
      "key": "story.event-forgottenShrine.c2",
      "tokens": [
        "它"
      ],
      "zh": "你退開,轉身。龕聲不變——它嗡了不知多少年,不缺你這一次。"
    },
    {
      "key": "story.event-forgottenShrine.coda",
      "tokens": [
        "它"
      ],
      "zh": "苔蘚長回祭品之上。這座龕收過的東西,比它應許過的多。"
    },
    {
      "key": "story.event-library.coda",
      "tokens": [
        "他們"
      ],
      "zh": "他們把等待寫足了一座書庫。沒有一頁寫過出發。"
    },
    {
      "key": "story.finale-win.b1.l1",
      "tokens": [
        "他們"
      ],
      "zh": "門開着。相同的身影一個接一個入城,次序與他們停下的次序相同。"
    },
    {
      "key": "story.finale.b1.l3",
      "tokens": [
        "它"
      ],
      "zh": "它坐下。你站起來。"
    },
    {
      "key": "story.opening.b2.l3",
      "tokens": [
        "他們"
      ],
      "zh": "他們說,門後是金城。到了那裏,你便到家了。"
    },
    {
      "key": "story.unsealing.b3.l3",
      "tokens": [
        "他們"
      ],
      "zh": "他們的數目,與你出發過的次數相同。"
    },
    {
      "key": "story.unsealing.b4.l1",
      "tokens": [
        "他們",
        "他們"
      ],
      "zh": "路上的碑,同時動了。那不是紀念:每一座都是一個站着死去的行者。他們沒有躺下,他們在等門開。"
    },
    {
      "key": "story.unsealing.b4.l2",
      "tokens": [
        "他們"
      ],
      "zh": "他們站直,列隊,把門推開。門認的是行過的人,與完整的一團火——整條隊,每一個都行過。"
    }
  ],
