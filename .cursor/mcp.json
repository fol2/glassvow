{
  "mcpServers": {
    "elevenlabs": {
      "type": "stdio",
      "command": "uvx",
      "args": ["elevenlabs-mcp"],
      "env": {
        "ELEVENLABS_API_KEY": "${env:ELEVENLABS_API_KEY}",
        "ELEVENLABS_MCP_BASE_PATH": "${workspaceFolder}",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    },
    "suno": {
      "url": "https://suno.mcp.acedata.cloud/mcp",
      "headers": {
        "Authorization": "Bearer ${env:ACEDATACLOUD_API_TOKEN}"
      }
    }
  }
}
