# Local capture packets — never commit raw 168-frame dumps
/artifacts/

# Godot editor cache — never commit
.godot/

# Export / build artifacts (repo-root only — unanchored `bin/` / `android/`
# would swallow vendored Sentry native libs under addons/sentry/)
/build/
/export/
*.apk
*.aab
*.ipa
*.exe
!addons/sentry/**/*.exe
*.x86_64
*.x86_32
*.arm32
*.arm64
*.pck
*.zip
*.dmg
*.tmp

# C# / Mono (if enabled later) — repo-root output dirs
.mono/
/bin/
/obj/
*.csproj.user
*.sln.user
*.user

# Claude Code session worktrees — machine-local checkouts, never commit
.claude/worktrees/

# IDE / OS
__pycache__/
*.py[cod]
.vs/
.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Local secrets / editor tokens (never commit)
*.token
.env
.env.*
export_credentials.cfg
*.keystore
*.jks

# Android gradle build template — machine-local, reinstalled from the pinned
# 4.7.2 android_source.zip (see docs/release-signing.md)
/android/

# Generated review page for #310 — 5 MB of inlined base64, rebuilt by
# docs/design/2026-08-16-scene-plates/build_review_page.py
docs/design/2026-08-16-scene-plates/review.html
.gstack/

# Tripo DCC Bridge is a local editor land hop (Studio → Godot), not runtime.
# Inspect license/hosts before vendoring. Do not enable on export.
addons/tripo*/
addons/Tripo*/
