+## Research-only two-slope payoff. Missing floor_per is exactly the prior law.
+func resource_payoff(stock: int, fx: Dictionary) -> int:
+	var q: int = maxi(0, stock)
+	var reserve: int = maxi(0, _ji(fx.get("reserve", 0)))
+	return _ji(fx["n"]) * maxi(0, q - reserve) + _ji(fx.get("floor_per", 0)) * mini(q, reserve)
+
