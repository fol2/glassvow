+++ b/domain/rules/combat.gd
@@ -693,6 +693,11 @@ func _shatter_enemy(run: RunState, cb: CombatState, e: EnemyCombatant) -> void:
 	cb.queue.append({"t": EventTypes.SHATTER, "idx": e.idx, "facetMax": e.facet_max})
 	add_status_enemy(cb, e, "vulnerable", 2)
 	gain_embers(run, cb, 2)
+	var flow: int = _sget(cb.player.statuses, "shatterflow")
+	if flow > 0:
+		cb.player.energy += flow
+		cb.queue.append({"t": EventTypes.ENERGY, "n": cb.player.energy})
+		draw_cards(run, cb, flow * 2)
 	if run.has_relic("prismCharm") and not cb.prism_procd:
 		cb.prism_procd = true
 		gain_embers(run, cb, 2)
