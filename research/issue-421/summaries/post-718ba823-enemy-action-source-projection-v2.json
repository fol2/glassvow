{"combatFunctions":{"_compute_intents":["func _compute_intents(run: RunState, cb: CombatState) -> void:","\tfor e: EnemyCombatant in cb.enemies:","\t\tif e.hp <= 0:","\t\t\tcontinue","\t\tvar last: String = e.last_moves[e.last_moves.size() - 1] if e.last_moves.size() >= 1 else \"\"","\t\tvar prev: String = e.last_moves[e.last_moves.size() - 2] if e.last_moves.size() >= 2 else \"\"","\t\te.move_key = EnemyAi.decide(","\t\t\te.key, cb.turn + 1, last, prev, float(e.hp) / float(e.max_hp), run.rng, e.flags","\t\t)","\t\tcb.queue.append({\"t\": EventTypes.INTENT, \"idx\": e.idx, \"move\": String(e.move_key)})","",""],"end_turn":["func end_turn(run: RunState, cb: CombatState) -> void:","\tif cb.over:","\t\treturn","\tvar p: PlayerCombatant = cb.player","\tcb.queue.append({\"t\": EventTypes.END_TURN})","\t# Hand end-of-turn penalties (burn / hex).","\tfor c: CardInst in cb.hand.duplicate():","\t\tvar d: Dictionary = card_data(c)","\t\tif d.get(\"endTurnDmg\") != null:","\t\t\tdamage_player(run, cb, _ji(d[\"endTurnDmg\"]), \"burn\")","\t\tif d.get(\"endTurnLoseHp\") != null:","\t\t\tdamage_player(run, cb, _ji(d[\"endTurnLoseHp\"]), \"burn\")","\t\tif cb.over:","\t\t\treturn","\tvar metallicize: int = _sget(p.statuses, \"metallicize\")","\tif metallicize > 0:","\t\tgain_block_player(cb, metallicize, false, run)","\tvar regen: int = _sget(p.statuses, \"regen\")","\tif regen > 0:","\t\theal_player(run, cb, regen)","\t# Discard hand.","\tvar uids: Array = []","\tfor c: CardInst in cb.hand:","\t\tuids.append(c.uid)","\tcb.discard.append_array(cb.hand)","\tcb.hand = []","\tcb.queue.append({\"t\": EventTypes.DISCARD_HAND, \"uids\": uids})","\t# Player debuffs (and turn-scoped buffs) tick down at end of your turn.","\tfor s: String in [\"vulnerable\", \"weak\", \"frail\", \"beacon\"]:","\t\t_tick_status(p.statuses, s)","","\t# ---- enemy phase","\tfor e: EnemyCombatant in cb.enemies:","\t\tif e.hp <= 0 or cb.over:","\t\t\tcontinue","\t\tvar poison: int = _sget(e.statuses, \"poison\")","\t\tif poison > 0:","\t\t\tvar next_hp: int = e.hp - poison","\t\t\tvar handoff: bool = next_hp <= 0 and _is_finale_handoff(e)","\t\t\tvar amount: int = poison","\t\t\tif handoff:","\t\t\t\tamount = maxi(0, e.hp - 1)","\t\t\t\te.hp = 1","\t\t\telse:","\t\t\t\te.hp = next_hp","\t\t\tcb.queue.append({","\t\t\t\t\"t\": EventTypes.HIT_ENEMY,","\t\t\t\t\"idx\": e.idx,","\t\t\t\t\"amount\": amount,","\t\t\t\t\"blocked\": 0,","\t\t\t\t\"hpAfter\": maxi(0, e.hp),","\t\t\t\t\"dead\": (not handoff) and e.hp <= 0,","\t\t\t\t\"poison\": true,","\t\t\t})","\t\t\t_tick_status(e.statuses, \"poison\")","\t\t\tif handoff:","\t\t\t\t_begin_finale_handoff(run, cb, e)","\t\t\t\tcontinue","\t\t\tif e.hp <= 0:","\t\t\t\t_on_enemy_death(run, cb, e)","\t\t\t\tcontinue","\t\te.block = 0","\t\tif e.staggered:","\t\t\t# A shattered pane spends its turn reseaming: the move is skipped, but","\t\t\t# its key still enters last_moves so rotation scripts don't repeat-lock.","\t\t\te.staggered = false","\t\t\te.last_moves.append(String(e.move_key))","\t\t\tcb.queue.append({\"t\": EventTypes.STAGGERED, \"idx\": e.idx})","\t\telse:","\t\t\tvar mv: Dictionary = e.move()","\t\t\tcb.queue.append({","\t\t\t\t\"t\": EventTypes.ENEMY_ACT,","\t\t\t\t\"idx\": e.idx,","\t\t\t\t\"move\": String(e.move_key),","\t\t\t\t\"name\": str(mv.get(\"name\", \"\")),","\t\t\t})","\t\t\te.last_moves.append(String(e.move_key))","\t\t\tif mv.get(\"dmg\") != null:","\t\t\t\tvar times: int = _ji(mv.get(\"times\", 1))","\t\t\t\tfor _t: int in range(times):","\t\t\t\t\tif cb.over:","\t\t\t\t\t\tbreak","\t\t\t\t\tdamage_player(run, cb, _ji(mv[\"dmg\"]), e.idx, true, e)","\t\t\t\tif mv.get(\"ramp\") != null:","\t\t\t\t\te.flags[\"rampBonus\"] = _ji(e.flags.get(\"rampBonus\", 0)) + _ji(mv[\"ramp\"])","\t\t\tif cb.over:","\t\t\t\treturn","\t\t\tif mv.get(\"block\") != null:","\t\t\t\tgain_block_enemy(cb, e, _ji(mv[\"block\"]), run)","\t\t\tif mv.get(\"heal\") != null:","\t\t\t\tvar heal_before: int = e.hp","\t\t\t\te.hp = mini(e.max_hp, e.hp + _ji(mv[\"heal\"]))","\t\t\t\tcb.queue.append({\"t\": EventTypes.HEAL, \"who\": e.idx, \"n\": e.hp - heal_before})","\t\t\tvar mv_fx_v: Variant = mv.get(\"fx\")","\t\t\tif mv_fx_v != null:","\t\t\t\tvar mv_fx: Array = mv_fx_v","\t\t\t\tfor s_v: Variant in mv_fx:","\t\t\t\t\tvar s: Dictionary = s_v","\t\t\t\t\tvar who: String = str(s.get(\"who\", \"\"))","\t\t\t\t\tif who == \"player\":","\t\t\t\t\t\tadd_status_player(cb, str(s[\"id\"]), _ji(s[\"n\"]))","\t\t\t\t\telif who == \"self\":","\t\t\t\t\t\tadd_status_enemy(cb, e, str(s[\"id\"]), _ji(s[\"n\"]))","\t\t\t\t\telif who == \"allies\":","\t\t\t\t\t\tfor ally: EnemyCombatant in cb.enemies:","\t\t\t\t\t\t\tif ally.hp > 0:","\t\t\t\t\t\t\t\tadd_status_enemy(cb, ally, str(s[\"id\"]), _ji(s[\"n\"]))","\t\t\tvar adds_v: Variant = mv.get(\"addCards\")","\t\t\tif typeof(adds_v) == TYPE_DICTIONARY:","\t\t\t\tvar adds: Dictionary = adds_v","\t\t\t\tfor _i: int in range(_ji(adds.get(\"n\", 1))):","\t\t\t\t\tvar added: CardInst = CardInst.new(","\t\t\t\t\t\trun.next_uid(), StringName(str(adds[\"id\"])), false","\t\t\t\t\t)","\t\t\t\t\tcb.discard.append(added)","\t\t\t\t\tcb.queue.append({\"t\": &\"addCard\", \"id\": String(added.id), \"where\": \"discard\"})","\t\t# Enemy end-of-action: ritual, debuff tick (a staggered turn still ticks).","\t\tvar ritual: int = _sget(e.statuses, \"ritual\")","\t\tif ritual > 0:","\t\t\tadd_status_enemy(cb, e, \"str\", ritual)","\t\t_tick_status(e.statuses, \"vulnerable\")","\t\t_tick_status(e.statuses, \"weak\")","\tif cb.over:","\t\treturn","\t_compute_intents(run, cb)","\t_start_player_turn(run, cb)","",""],"preview_enemy_dmg":["func preview_enemy_dmg(","\tcb: CombatState, e: EnemyCombatant, run: RunState = null",") -> Variant:","\tvar mv: Dictionary = e.move()","\tvar dmg_v: Variant = mv.get(\"dmg\")","\tif dmg_v == null:","\t\treturn null","\tvar dmg: int = _ji(dmg_v) + _sget(e.statuses, \"str\") + _ji(e.flags.get(\"rampBonus\", 0))","\tif run != null:","\t\tdmg += _ji(_omen_mods(run).get(\"enemyDmgBonus\", 0))","\t\tdmg += _ji(_vow_mods(run).get(\"enemyDmgBonus\", 0))","\tif _sget(e.statuses, \"weak\") > 0:","\t\tdmg = int(floorf(float(dmg) * 0.75))","\tif _sget(cb.player.statuses, \"vulnerable\") > 0:","\t\tdmg = int(floorf(float(dmg) * 1.5))","\tif run != null and run.has_relic(\"wardingCharm\") and dmg > 0 and dmg <= 5:","\t\tdmg = 1","\treturn {\"dmg\": maxi(0, dmg), \"times\": _ji(mv.get(\"times\", 1))}","","","## What would this card actually do to this target? null when it previews nothing."]},"commercialSections":{"## 1. Save Versioning & Migration Policy":["## 1. Save Versioning & Migration Policy","","**Envelope structure:** Each save is a versioned container with a schema version, user-facing content, and metadata. Schema changes = version bump.","","**When to migrate:**","- **Additive change** (new field with a safe default): bump minor version, apply default on load.","- **Removed field** (unsupported feature): bump major version, provide a migration handler or reject old saves.","- **Renamed or restructured field**: always a major version (break in contract).","","**Web → native never migrates:** Save formats are platform-specific by design. A user's web progress is archived; native restarts the player at zero. (Exception: future web-to-web ports can migrate if schemas align, but this requires deliberate alignment.)","","**Stale content handling:** On load, validate every content ID (card, relic, enemy, status) against the current content registry. Missing IDs are replaced with null/baseline values, or the entire save is rejected if critical IDs fail. This prevents crashes from removed content.","","**Versioned lineage:** Each game/platform pins a save version. Once a milestone ships (e.g., M4 in this plan), that save version is frozen. Future schema changes start a new major version line (e.g., v2), with a migration story documented.",""],"## 3. Determinism Contract":["## 3. Determinism Contract","","**One seeded RNG stream per run:** A run's seed produces exactly one pseudo-random stream (e.g., Mulberry32 or similar). Every random draw (shuffle, enemy AI, variance in damage) pulls from this stream in a fixed order. The stream state is persisted; resuming a run replays from the same cursor.","","**Fixtures as spec:** Snapshot saves, action traces, and final outcomes are committed as JSON fixtures. A new implementation must reproduce these traces byte-for-byte (within numeric precision, e.g., same floor/round semantics for damage). Fixtures prove parity.","","**No other randomness sources:** Wall-clock time, user input timing, network latency — none of these are game-state RNG. They may affect scheduling or UI, but not the run's outcome.","","**Replayability:** Given a seed and a trace of actions, any implementation reproduces the same events and final state. This enables:","- Deterministic test fixtures.","- Replay mode (watch a previous run).","- Cross-platform sync (cloud save desync detection via trace).",""],"## 4. Content-ID Stability":["## 4. Content-ID Stability","","**IDs are immutable once frozen:** Internal IDs for cards, relics, enemies, statuses, and abilities are engine-level constants. Once a release ships with a set of IDs, changing an ID breaks all prior saves (they reference the old ID). Removals, renames, splits, and merges all require a save-version bump and migration logic.","","**Display vs. internal:** Internally, a card is `\"strike\"` (the ID). The player sees \"Strike\", \"鬥擊\", or \"Attaque\" depending on locale. Display strings change freely; IDs do not.","","**Content-addition gates:** Adding new content (cards, relics, enemies) is safe if IDs don't collide and the new content doesn't introduce dependencies on yet-unavailable features. Coordinate additions with the release checklist to avoid partial shipments.","","**Deprecated IDs:** If an ID must be removed, leave a migration handler: \"Card X was removed; players' decks that have it swap it for Card Y.\" This allows old saves to load without rejection.",""],"## 6. Release Gates & Stop Conditions":["## 6. Release Gates & Stop Conditions","","**Glassvow's release-candidate gate:** `docs/rc-bar.md` instantiates this section for the iOS","release candidate — the nine-pillar bar that issue #108 checks a build against.","","**Milestone gates:** Before advancing, verify:","- All acceptance tests green (parity fixtures, if applicable).","- No regressions in previous milestones.","- One human visual review (art, UI, gameplay feel) passes.","- Performance budgets met on target device.","","**Stop conditions (halt and re-plan):**","- **Schema change** — save format breaks compatibility without a migration story.","- **New platform plugin work** — native SDK integration (e.g., push notifications, in-app purchase) is a separate deliverable and expertise.","- **Per-file code change >600 lines** — in one commit, additions plus deletions","  to any one code file exceed 600 lines. Evidence artefacts are excluded. Split","  the commit or surface the findings and produce a revised plan.","","**Red = handled event, not emergency:** A failed test or CI gate means the change is incomplete. Fix it, re-run, and advance. There is no \"we'll ship it anyway and fix it later\" for save-critical or determinism-critical code.","","**Deliberate simplifications:** Mark known ceilings with a searchable comment:","```","# ceiling: global lock; per-account locks if throughput matters","# ceiling: O(n²) search; hash-table indexing if content scales","```","","This acknowledges the trade-off and documents the upgrade path for future scale."]},"conceptIntent":["### Intent","The move an enemy has telegraphed for its next turn, shown above the actor. It is","pushed to the actor by the combat sequencer rather than read from combat state —","an actor never inspects the game itself.","","An intent may name more than one action at once. When it does the first action is","the **primary**: it decides the single colour the entire telegraph is tinted, and","the further actions are shown alongside it rather than each carrying their own","colour. A compound intent is therefore one telegraph in one colour, not several","stacked — treating it as a fallback for \"unknown intent\" is a misreading.",""],"content":{"encounterTiers":["boss","elite","normal","weak"],"enemyCount":36,"enemyMoves":{"abyssalKnight":{"blade":{"dmg":15,"intent":"attack"},"condemn":{"fx":[{"id":"vulnerable","n":2,"who":"player"},{"id":"weak","n":2,"who":"player"}],"intent":"debuff"},"execute":{"dmg":9,"intent":"attack","times":2},"oath":{"block":14,"fx":[{"id":"str","n":2,"who":"self"}],"intent":"buff"}},"alphaFang":{"howl":{"fx":[{"id":"str","n":3,"who":"self"}],"intent":"buff"},"savage":{"dmg":5,"intent":"attack","times":2},"throat":{"dmg":13,"intent":"attack"}},"ashAcolyte":{"ritual":{"fx":[{"id":"ritual","n":2,"who":"self"}],"intent":"buff"},"scorch":{"dmg":6,"intent":"attack"}},"chaosHound":{"bite":{"dmg":9,"intent":"attack","ramp":3},"howl":{"fx":[{"id":"str","n":2,"who":"self"}],"intent":"buff"}},"deepmaw":{"bite":{"dmg":14,"intent":"attack"},"lure":{"fx":[{"id":"vulnerable","n":2,"who":"player"}],"intent":"debuff"},"swallow":{"dmg":8,"heal":8,"intent":"attack_buff"}},"drownedOne":{"claw":{"dmg":11,"intent":"attack"},"frenzy":{"dmg":4,"intent":"attack","times":3},"gurgle":{"dmg":5,"fx":[{"id":"weak","n":2,"who":"player"}],"intent":"attack_debuff"}},"duskfang":{"bite":{"dmg":7,"intent":"attack"},"howl":{"fx":[{"id":"str","n":2,"who":"self"}],"intent":"buff"},"rend":{"dmg":4,"intent":"attack","times":2}},"eternalKeeper":{"cinderFall":{"dmg":11,"intent":"attack","times":2},"hearthBlow":{"dmg":18,"intent":"attack"},"keepTheFire":{"block":30,"fx":[{"id":"str","n":4,"who":"self"}],"intent":"buff"},"kindWord":{"dmg":4,"fx":[{"id":"poison","n":4,"who":"player"},{"id":"weak","n":2,"who":"player"},{"id":"frail","n":2,"who":"player"}],"intent":"attack_debuff"},"neverLeave":{"dmg":34,"intent":"attack"},"sit