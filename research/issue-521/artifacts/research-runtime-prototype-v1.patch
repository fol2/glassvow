+## Efraimidis-Spirakis exponential keys, one counter-based uniform per
+## (cursor, rarity, card). Weights change scores, never the uniform definition.
+func _roll_card_reward_weighted(run: RunState, kind: String, wanted: int) -> Array:
+	var plan: Dictionary = _exposure_plan(run, wanted)
+	if not plan.get("ok", false):
+		push_error("RewardRules: refusing card reward exposure — %s" % str(plan.get("error", "invalid")))
+		return []
+	var cursor: int = run.rng_state()
+	var tiers: Array[String] = []
+	for offer: int in range(wanted):
+		if kind == "boss":
+			tiers.append("rare")
+			continue
+		var rarity_uniform: float = _exposure_uniform(cursor, "rarity|%d" % offer)
+		var cuts: Vector2 = _rarity_cuts(kind)
+		tiers.append("common" if rarity_uniform < cuts.x else (
+			"uncommon" if rarity_uniform < cuts.y else "rare"))
+	var selected: Dictionary = {}
+	var cards: Array[String] = []
+	var pools: Dictionary = plan["pools"]
+	for tier: String in tiers:
+		var weights: Dictionary = pools[tier]
+		var ids: Array = weights.keys()
+		ids.sort()
+		var best_id: String = ""
+		var best_score: float = -INF
+		for id_v: Variant in ids:
+			var id: String = str(id_v)
+			var weight: float = float(str(weights[id_v]))
+			if weight <= 0.0 or selected.has(id):
+				continue
+			var uniform: float = _exposure_uniform(cursor, "card|%s|%s" % [tier, id])
+			var score: float = log(uniform) / weight
+			if best_id.is_empty() or score > best_score \
+					or (is_equal_approx(score, best_score) and id < best_id):
+				best_id = id
+				best_score = score
+		if best_id.is_empty():
+			push_error("RewardRules: refusing under-supported weighted reward after cross-tier exclusion")
+			return []
+		selected[best_id] = true
+		cards.append(best_id)
+	return cards
+
+
+func _exposure_is_identity(run: RunState) -> bool:
+	var raw: Variant = content.card_reward_exposure
+	if raw == null:
+		return true
+	if typeof(raw) != TYPE_DICTIONARY:
+		return false
+	var config: Dictionary = raw
+	if config.is_empty():
+		return true
+	for key_v: Variant in config:
+		if typeof(key_v) != TYPE_STRING or not EXPOSURE_KEYS.has(str(key_v)):
+			return false
+	if str(config.get("algorithm", "")) != EXPOSURE_ALGORITHM:
+		return false
+	var default_v: Variant = config.get("defaultWeight", 1.0)
+	if not _valid_exposure_weight(default_v) or not is_equal_approx(float(str(default_v)), 1.0):
+		return false
+	var pools_v: Variant = config.get("pools", {})
+	if typeof(pools_v) != TYPE_DICTIONARY:
+		return false
+	var pools: Dictionary = pools_v
+	for tier_v: Variant in pools:
+		if typeof(tier_v) != TYPE_STRING:
+			return false
+		var tier: String = str(tier_v)
+		if not EXPOSURE_TIERS.has(tier) or typeof(pools[tier_v]) != TYPE_DICTIONARY:
+			return false
+		var authored: Array = content.card_pools.get(tier, [])
+		var overrides: Dictionary = pools[tier_v]
+		for id_v: Variant in overrides:
+			var weight_v: Variant = overrides[id_v]
+			if typeof(id_v) != TYPE_STRING or not authored.has(str(id_v)) \
+					or not _valid_exposure_weight(weight_v) \
+					or not is_equal_approx(float(str(weight_v)), 1.0):
+				return false
+	return true
+
+
+func _exposure_plan(run: RunState, wanted: int) -> Dictionary:
+	var raw: Variant = content.card_reward_exposure
+	if typeof(raw) != TYPE_DICTIONARY:
+		return _exposure_error("configuration must be a dictionary")
+	var config: Dictionary = raw
+	for key_v: Variant in config:
+		if typeof(key_v) != TYPE_STRING or not EXPOSURE_KEYS.has(str(key_v)):
+			return _exposure_error("unknown configuration key %s" % str(key_v))
+	if str(config.get("algorithm", "")) != EXPOSURE_ALGORITHM:
+		return _exposure_error("algorithm must be %s" % EXPOSURE_ALGORITHM)
+	var default_v: Variant = config.get("defaultWeight", 1.0)
+	if not _valid_exposure_weight(default_v):
+		return _exposure_error("defaultWeight must be finite and non-negative")
+	var default_weight: float = float(str(default_v))
+	var configured_v: Variant = config.get("pools", {})
+	if typeof(configured_v) != TYPE_DICTIONARY:
+		return _exposure_error("pools must be a dictionary")
+	var configured: Dictionary = configured_v
+	for tier_v: Variant in configured:
+		if typeof(tier_v) != TYPE_STRING or not EXPOSURE_TIERS.has(str(tier_v)):
+			return _exposure_error("unknown rarity pool %s" % str(tier_v))
+	var effective: Dictionary = {}
+	for tier: String in EXPOSURE_TIERS:
+		var base: Array = card_pool(run, tier)
+		var weights: Dictionary = {}
+		for id_v: Variant in base:
+			var id: String = str(id_v)
+			if weights.has(id):
+				return _exposure_error("legacy %s pool contains duplicate %s" % [tier, id])
+			weights[id] = default_weight
+		var overrides_v: Variant = configured.get(tier, {})
+		if typeof(overrides_v) != TYPE_DICTIONARY:
+			return _exposure_error("%s pool weights must be a dictionary" % tier)
+		var overrides: Dictionary = overrides_v
+		var ids: Array = overrides.keys()
+		ids.sort()
+		for id_v: Variant in ids:
+			if typeof(id_v) != TYPE_STRING:
+				return _exposure_error("%s pool has a non-string card id" % tier)
+			var id: String = str(id_v)
+			if not content.cards.has(id):
+				return _exposure_error("%s pool names unknown card %s" % [tier, id])
+			var weight_v: Variant = overrides[id_v]
+			if not _valid_exposure_weight(weight_v):
+				return _exposure_error("%s.%s weight must be finite and non-negative" % [tier, id])
+			if _pool_open(run, content.pool_gate_cards, id):
+				weights[id] = float(str(weight_v))
+		var support: int = 0
+		for weight_v: Variant in weights.values():
+			if float(str(weight_v)) > 0.0:
+				support += 1
+		if support == 0:
+			return _exposure_error("%s pool has zero effective support" % tier)
+		if support < wanted:
+			return _exposure_error("%s pool support %d is below offer size %d" % [tier, support, wanted])
+		effective[tier] = weights
+	return {"ok": true, "pools": effective}
+
+
+static func _valid_exposure_weight(value: Variant) -> bool:
+	if typeof(value) != TYPE_INT and typeof(value) != TYPE_FLOAT:
+		return false
+	var number: float = float(str(value))
+	return is_finite(number) and number >= 0.0
+
+
+static func _exposure_error(message: String) -> Dictionary:
+	return {"ok": false, "error": message}
+
+
+static func _exposure_uniform(cursor: int, lane: String) -> float:
+	var token: String = "%s|%d|%s" % [EXPOSURE_ALGORITHM, cursor, lane]
+	var bits: int = token.sha256_text().substr(0, 13).hex_to_int()
+	return (float(bits) + 0.5) / EXPOSURE_UNIFORM_SCALE
+
+
